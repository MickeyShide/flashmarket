INVENTORY_IMAGE=ghcr.io/mickeyshide/flashmarket-inventory@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
INVENTORY_PROXY_PORT=4919
INVENTORY_ENVIRONMENT=production
INVENTORY_DOMAIN=inventory.example.com
INVENTORY_DATABASE_URL=postgresql+asyncpg://${INFRA_USER:-shide}:${POSTGRES_PASSWORD:-shide}@shide-postgres:5432/inventory
INVENTORY_REDIS_URL=redis://:${REDIS_PASSWORD:-shide}@shide-redis:6379/2
INVENTORY_STOCK_CACHE_TTL_SECONDS=30
INVENTORY_REDIS_SOCKET_TIMEOUT_SECONDS=0.2
INVENTORY_RABBITMQ_URL=amqp://${INFRA_USER:-shide}:${RABBITMQ_PASSWORD:-shide}@shide-rabbitmq:5672//inventory
INVENTORY_ALLOW_INSECURE_INTERNAL_SERVICES=true
INVENTORY_DEBUG=false
INVENTORY_DOCS_ENABLED=false
INVENTORY_CORS_ORIGINS=["https://inventory.example.com"]
INVENTORY_TRUSTED_HOSTS=["inventory.example.com","localhost"]
INVENTORY_RESERVATION_TTL_SECONDS=300
INFRA_USER=shide
POSTGRES_PASSWORD=00000000000000000000000000000000
REDIS_PASSWORD=11111111111111111111111111111111
RABBITMQ_PASSWORD=22222222222222222222222222222222
