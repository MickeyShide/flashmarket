PAYMENTS_IMAGE=ghcr.io/mickeyshide/flashmarket-payments@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
PAYMENTS_PROXY_PORT=4921
PAYMENTS_ENVIRONMENT=production
PAYMENTS_DOMAIN=payments.example.com
PAYMENTS_DATABASE_URL=postgresql+asyncpg://${INFRA_USER:-shide}:${POSTGRES_PASSWORD:-shide}@shide-postgres:5432/payments
PAYMENTS_RABBITMQ_URL=amqp://${INFRA_USER:-shide}:${RABBITMQ_PASSWORD:-shide}@shide-rabbitmq:5672/flashmarket
PAYMENTS_ALLOW_INSECURE_INTERNAL_SERVICES=true
PAYMENTS_DEBUG=false
PAYMENTS_DOCS_ENABLED=false
PAYMENTS_CORS_ORIGINS=["https://payments.example.com"]
PAYMENTS_TRUSTED_HOSTS=["payments.example.com","localhost"]
PAYMENTS_PAYMENT_PROVIDER=mock
PAYMENTS_YOOKASSA_SHOP_ID=
PAYMENTS_YOOKASSA_SECRET_KEY=
PAYMENTS_YOOKASSA_API_URL=https://api.yookassa.ru/v3
PAYMENTS_YOOKASSA_RETURN_URL=https://example.com/payment/return
PAYMENTS_YOOKASSA_TEST_MODE_REQUIRED=true
INFRA_USER=shide
POSTGRES_PASSWORD=00000000000000000000000000000000
RABBITMQ_PASSWORD=22222222222222222222222222222222
