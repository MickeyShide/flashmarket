NOTIFICATIONS_ENVIRONMENT=development
NOTIFICATIONS_DATABASE_URL=postgresql+asyncpg://${INFRA_USER:-shide}:${POSTGRES_PASSWORD:-shide}@shide-postgres:5432/notifications
NOTIFICATIONS_DATABASE_API_POOL_SIZE=3
NOTIFICATIONS_DATABASE_API_MAX_OVERFLOW=2
NOTIFICATIONS_DATABASE_WORKER_POOL_SIZE=1
NOTIFICATIONS_DATABASE_WORKER_MAX_OVERFLOW=1
NOTIFICATIONS_DATABASE_POOL_TIMEOUT_SECONDS=5
NOTIFICATIONS_DATABASE_POOL_RECYCLE_SECONDS=1800
NOTIFICATIONS_API_MEMORY_LIMIT=192m
NOTIFICATIONS_WORKER_MEMORY_LIMIT=160m
NOTIFICATIONS_RABBITMQ_URL=amqp://${INFRA_USER:-shide}:${RABBITMQ_PASSWORD:-shide}@shide-rabbitmq:5672/flashmarket
NOTIFICATIONS_CORS_ORIGINS='["http://localhost:3000"]'
NOTIFICATIONS_TRUSTED_HOSTS='["localhost","127.0.0.1"]'
NOTIFICATIONS_DOCS_ENABLED=true
NOTIFICATIONS_DEBUG=false
NOTIFICATIONS_ALLOW_INSECURE_INTERNAL_SERVICES=true
INFRA_USER=shide
POSTGRES_PASSWORD=shide
RABBITMQ_PASSWORD=shide
