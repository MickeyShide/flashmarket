CATALOG_ENVIRONMENT=development
CATALOG_DEBUG=false
CATALOG_DATABASE_URL=postgresql+asyncpg://${INFRA_USER:-shide}:${POSTGRES_PASSWORD:-shide}@shide-postgres:5432/catalog
CATALOG_REDIS_URL=redis://shide-redis:6379/1
CATALOG_RABBITMQ_URL=amqp://${INFRA_USER:-shide}:${RABBITMQ_PASSWORD:-shide}@shide-rabbitmq:5672//catalog
CATALOG_DOCS_ENABLED=true
CATALOG_CORS_ORIGINS=["http://localhost:3000"]
CATALOG_TRUSTED_HOSTS=["localhost","127.0.0.1"]
CATALOG_TRUSTED_PROXY_IPS=[]
CATALOG_ALLOW_INSECURE_INTERNAL_SERVICES=true
INFRA_USER=shide
POSTGRES_PASSWORD=shide
RABBITMQ_PASSWORD=shide
