CATALOG_IMAGE=ghcr.io/mickeyshide/flashmarket-catalog@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
CATALOG_PROXY_PORT=4919
CATALOG_ENVIRONMENT=production
CATALOG_DOMAIN=catalog.example.com
CATALOG_DATABASE_URL=postgresql+asyncpg://${INFRA_USER:-shide}:${POSTGRES_PASSWORD:-shide}@shide-postgres:5432/catalog
CATALOG_REDIS_URL=redis://shide-redis:6379/1
CATALOG_CATEGORY_CACHE_TTL_SECONDS=60
CATALOG_REDIS_SOCKET_TIMEOUT_SECONDS=0.2
CATALOG_RABBITMQ_URL=amqp://${INFRA_USER:-shide}:${RABBITMQ_PASSWORD:-shide}@shide-rabbitmq:5672//catalog
CATALOG_ALLOW_INSECURE_INTERNAL_SERVICES=true
CATALOG_JWT_KEYS_DIRECTORY=/var/lib/flashmarket-catalog/keys
CATALOG_JWT_KEY_ID=flashmarket-catalog-ed25519-v1
CATALOG_JWT_ISSUER=flashmarket-catalog
CATALOG_JWT_AUDIENCE=flashmarket-api
CATALOG_DEBUG=false
CATALOG_DOCS_ENABLED=false
CATALOG_RATE_LIMIT_ENABLED=true
CATALOG_CORS_ORIGINS=["https://catalog.example.com"]
CATALOG_TRUSTED_HOSTS=["catalog.example.com","localhost"]
CATALOG_TRUSTED_PROXY_IPS=["172.16.0.0/12"]
CATALOG_REFRESH_TOKEN_TRANSPORT=cookie
CATALOG_REFRESH_COOKIE_SECURE=true
CATALOG_REFRESH_COOKIE_NAME=__Host-flashmarket-refresh
CATALOG_CSRF_COOKIE_NAME=__Host-flashmarket-csrf
CATALOG_REFRESH_COOKIE_SAMESITE=strict
INFRA_USER=shide
POSTGRES_PASSWORD=00000000000000000000000000000000
REDIS_PASSWORD=11111111111111111111111111111111
RABBITMQ_PASSWORD=22222222222222222222222222222222
