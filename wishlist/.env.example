WISHLIST_ENVIRONMENT=development
WISHLIST_DEBUG=false
WISHLIST_DATABASE_URL=postgresql+asyncpg://shide:shide@shide-postgres:5432/wishlist
WISHLIST_DATABASE_API_POOL_SIZE=3
WISHLIST_DATABASE_API_MAX_OVERFLOW=2
WISHLIST_DATABASE_WORKER_POOL_SIZE=1
WISHLIST_DATABASE_WORKER_MAX_OVERFLOW=1
WISHLIST_DATABASE_POOL_TIMEOUT_SECONDS=5
WISHLIST_DATABASE_POOL_RECYCLE_SECONDS=1800
WISHLIST_API_MEMORY_LIMIT=192m
WISHLIST_WORKER_MEMORY_LIMIT=160m
WISHLIST_LOG_FILE_PATH=
WISHLIST_PROMETHEUS_MULTIPROC_DIR=
WISHLIST_DOCS_ENABLED=true
WISHLIST_TRUSTED_HOSTS=["localhost","127.0.0.1"]
WISHLIST_CORS_ORIGINS=["http://localhost:3000"]
WISHLIST_ALLOW_INSECURE_INTERNAL_SERVICES=true
WISHLIST_MAX_ITEMS_PER_USER=200
