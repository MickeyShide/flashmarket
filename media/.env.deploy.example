MEDIA_IMAGE=ghcr.io/mickeyshide/flashmarket-media@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
MEDIA_ENVIRONMENT=production
MEDIA_DATABASE_URL=postgresql+asyncpg://${INFRA_USER}:${POSTGRES_PASSWORD}@shide-postgres:5432/media
MEDIA_S3_INTERNAL_ENDPOINT=http://shide-minio:9000
MEDIA_S3_PUBLIC_ENDPOINT=https://flashmarket.example.com/media-storage
MEDIA_S3_ACCESS_KEY=${S3_ACCESS_KEY}
MEDIA_S3_SECRET_KEY=${S3_SECRET_KEY}
MEDIA_S3_BUCKET=flashmarket-public
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ADDRESSING_STYLE=path
MEDIA_PUBLIC_BASE_URL=https://flashmarket.example.com/media-storage/flashmarket-public
MEDIA_UPLOAD_TTL_SECONDS=600
MEDIA_CLEANUP_INTERVAL_SECONDS=30
MEDIA_CORS_ORIGINS=["https://example.com"]
MEDIA_TRUSTED_HOSTS=["media.example.com","localhost"]
MEDIA_ALLOW_INSECURE_INTERNAL_SERVICES=true
MEDIA_DEBUG=false
MEDIA_DOCS_ENABLED=false
INFRA_USER=flashmarket
POSTGRES_PASSWORD=00000000000000000000000000000000
S3_ACCESS_KEY=flashmarket-media
S3_SECRET_KEY=11111111111111111111111111111111
