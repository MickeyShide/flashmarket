MEDIA_ENVIRONMENT=development
MEDIA_DATABASE_URL=postgresql+asyncpg://${INFRA_USER:-shide}:${POSTGRES_PASSWORD:-shide}@shide-postgres:5432/media
MEDIA_S3_INTERNAL_ENDPOINT=http://shide-minio:9000
MEDIA_S3_PUBLIC_ENDPOINT=http://localhost:9000
MEDIA_S3_ACCESS_KEY=${S3_ACCESS_KEY:-shide}
MEDIA_S3_SECRET_KEY=${S3_SECRET_KEY:-shide}
MEDIA_S3_BUCKET=flashmarket-public
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ADDRESSING_STYLE=path
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/flashmarket-public
MEDIA_UPLOAD_TTL_SECONDS=600
MEDIA_CLEANUP_INTERVAL_SECONDS=30
MEDIA_MAX_PENDING_PER_USER=10
MEDIA_MAX_USER_ASSETS=200
MEDIA_MAX_USER_BYTES=524288000
MEDIA_MAX_IMAGE_PIXELS=40000000
MEDIA_CORS_ORIGINS=["http://localhost:3000"]
MEDIA_TRUSTED_HOSTS=["localhost","127.0.0.1","test","testserver"]
MEDIA_ALLOW_INSECURE_INTERNAL_SERVICES=true
MEDIA_JWT_PUBLIC_KEY_DIR=/var/lib/flashmarket/keys/public
INFRA_USER=shide
POSTGRES_PASSWORD=shide
S3_ACCESS_KEY=shide
S3_SECRET_KEY=shide
