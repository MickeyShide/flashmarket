AUTH_ENVIRONMENT=development
AUTH_DEBUG=false
AUTH_DATABASE_URL=postgresql+asyncpg://${INFRA_USER:-shide}:${POSTGRES_PASSWORD:-shide}@shide-postgres:5432/auth
AUTH_DATABASE_API_POOL_SIZE=3
AUTH_DATABASE_API_MAX_OVERFLOW=2
AUTH_DATABASE_WORKER_POOL_SIZE=1
AUTH_DATABASE_WORKER_MAX_OVERFLOW=1
AUTH_DATABASE_POOL_TIMEOUT_SECONDS=5
AUTH_DATABASE_POOL_RECYCLE_SECONDS=1800
AUTH_PASSWORD_WORK_CONCURRENCY=2
AUTH_PASSWORD_WORK_ACQUIRE_TIMEOUT_SECONDS=5
AUTH_API_MEMORY_LIMIT=256m
AUTH_WORKER_MEMORY_LIMIT=160m
AUTH_MAINTENANCE_MEMORY_LIMIT=128m
AUTH_REDIS_URL=redis://shide-redis:6379/0
AUTH_RABBITMQ_URL=amqp://${INFRA_USER:-shide}:${RABBITMQ_PASSWORD:-shide}@shide-rabbitmq:5672/flashmarket
CELERY_BROKER_URL=amqp://${INFRA_USER:-shide}:${RABBITMQ_PASSWORD:-shide}@shide-rabbitmq:5672/flashmarket-tasks
CELERY_AUTH_CLEANUP_INTERVAL_SECONDS=3600
CELERY_INVENTORY_EXPIRY_INTERVAL_SECONDS=5
CELERY_DROPS_SCHEDULER_INTERVAL_SECONDS=10
CELERY_MEDIA_CLEANUP_INTERVAL_SECONDS=30
AUTH_RABBITMQ_EXCHANGE=flashmarket.events
AUTH_OUTBOX_BATCH_SIZE=100
AUTH_OUTBOX_POLL_INTERVAL_SECONDS=1
AUTH_JWT_KEYS_DIRECTORY=keys
AUTH_JWT_KEY_ID=flashmarket-auth-ed25519-v1
AUTH_JWT_ISSUER=flashmarket-auth
AUTH_JWT_AUDIENCE=flashmarket-api
AUTH_ACCESS_TOKEN_TTL_MINUTES=5
AUTH_SESSION_TTL_DAYS=30
AUTH_SESSION_TOUCH_INTERVAL_MINUTES=5
AUTH_CORS_ORIGINS=["http://localhost:3000"]
AUTH_TRUSTED_PROXY_IPS=[]
AUTH_TRUSTED_HOSTS=["localhost","127.0.0.1"]
AUTH_DOCS_ENABLED=true
AUTH_REFRESH_TOKEN_TRANSPORT=cookie
AUTH_REFRESH_COOKIE_NAME=flashmarket_refresh
AUTH_CSRF_COOKIE_NAME=flashmarket_csrf
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAMESITE=strict
AUTH_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_IP_RATE_LIMIT=20
AUTH_LOGIN_ACCOUNT_RATE_LIMIT=5
AUTH_LOGIN_RATE_WINDOW_SECONDS=60
AUTH_REGISTER_RATE_LIMIT=5
AUTH_REGISTER_RATE_WINDOW_SECONDS=3600
AUTH_REFRESH_RATE_LIMIT=30
AUTH_REFRESH_RATE_WINDOW_SECONDS=300
AUTH_INTROSPECTION_RATE_LIMIT=300
AUTH_INTROSPECTION_RATE_WINDOW_SECONDS=60
AUTH_EXPIRED_DATA_RETENTION_DAYS=30
AUTH_AUDIT_RETENTION_DAYS=365
INFRA_USER=shide
POSTGRES_PASSWORD=shide
RABBITMQ_PASSWORD=shide
