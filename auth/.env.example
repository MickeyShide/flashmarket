AUTH_ENVIRONMENT=development
AUTH_DEBUG=false
AUTH_DATABASE_URL=postgresql+asyncpg://flashmarket:flashmarket@localhost:5432/auth
AUTH_REDIS_URL=redis://localhost:6379/0
AUTH_RABBITMQ_URL=amqp://flashmarket:flashmarket@localhost:5672/
AUTH_RABBITMQ_EXCHANGE=flashmarket.events
AUTH_OUTBOX_BATCH_SIZE=100
AUTH_OUTBOX_POLL_INTERVAL_SECONDS=1
AUTH_JWT_KEYS_DIRECTORY=keys
AUTH_JWT_KEY_ID=flashmarket-auth-ed25519-v1
AUTH_JWT_ISSUER=flashmarket-auth
AUTH_JWT_AUDIENCE=flashmarket-api
AUTH_ACCESS_TOKEN_TTL_MINUTES=5
AUTH_SESSION_TTL_DAYS=30
AUTH_SESSION_TOUCH_INTERVAL_MINUTES=5
AUTH_CORS_ORIGINS=["http://localhost:3000"]
AUTH_TRUSTED_PROXY_IPS=[]
AUTH_TRUSTED_HOSTS=["localhost","127.0.0.1"]
AUTH_DOCS_ENABLED=true
AUTH_REFRESH_TOKEN_TRANSPORT=cookie
AUTH_REFRESH_COOKIE_NAME=flashmarket_refresh
AUTH_CSRF_COOKIE_NAME=flashmarket_csrf
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAMESITE=strict
AUTH_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_IP_RATE_LIMIT=20
AUTH_LOGIN_ACCOUNT_RATE_LIMIT=5
AUTH_LOGIN_RATE_WINDOW_SECONDS=60
AUTH_REGISTER_RATE_LIMIT=5
AUTH_REGISTER_RATE_WINDOW_SECONDS=3600
AUTH_REFRESH_RATE_LIMIT=30
AUTH_REFRESH_RATE_WINDOW_SECONDS=300
AUTH_INTROSPECTION_RATE_LIMIT=300
AUTH_INTROSPECTION_RATE_WINDOW_SECONDS=60
AUTH_EXPIRED_DATA_RETENTION_DAYS=30
AUTH_AUDIT_RETENTION_DAYS=365
