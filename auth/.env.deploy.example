AUTH_ENVIRONMENT=production
AUTH_DOMAIN=auth.example.com
AUTH_DATABASE_URL=postgresql+asyncpg://flashmarket_auth:00000000000000000000000000000000@db:5432/auth
AUTH_REDIS_URL=redis://:11111111111111111111111111111111@redis:6379/0
AUTH_RABBITMQ_URL=amqp://flashmarket_auth:22222222222222222222222222222222@rabbitmq:5672/
AUTH_ALLOW_INSECURE_INTERNAL_SERVICES=true
AUTH_JWT_KEYS_DIRECTORY=/var/lib/flashmarket-auth/keys
AUTH_JWT_KEY_ID=flashmarket-auth-ed25519-v1
AUTH_JWT_ISSUER=flashmarket-auth
AUTH_JWT_AUDIENCE=flashmarket-api
AUTH_DEBUG=false
AUTH_DOCS_ENABLED=false
AUTH_RATE_LIMIT_ENABLED=true
AUTH_CORS_ORIGINS=["https://auth.example.com"]
AUTH_TRUSTED_HOSTS=["auth.example.com","localhost"]
AUTH_TRUSTED_PROXY_IPS=["172.16.0.0/12"]
AUTH_REFRESH_TOKEN_TRANSPORT=cookie
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_NAME=__Host-flashmarket-refresh
AUTH_CSRF_COOKIE_NAME=__Host-flashmarket-csrf
AUTH_REFRESH_COOKIE_SAMESITE=strict
POSTGRES_DB=auth
POSTGRES_USER=flashmarket_auth
POSTGRES_PASSWORD=00000000000000000000000000000000
REDIS_PASSWORD=11111111111111111111111111111111
RABBITMQ_DEFAULT_USER=flashmarket_auth
RABBITMQ_DEFAULT_PASS=22222222222222222222222222222222
