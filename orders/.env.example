ORDERS_ENVIRONMENT=development
ORDERS_DATABASE_URL=postgresql+asyncpg://${INFRA_USER:-shide}:${POSTGRES_PASSWORD:-shide}@shide-postgres:5432/orders
ORDERS_RABBITMQ_URL=amqp://${INFRA_USER:-shide}:${RABBITMQ_PASSWORD:-shide}@shide-rabbitmq:5672//orders
ORDERS_PAYMENT_TIMEOUT_SECONDS=300
ORDERS_CORS_ORIGINS='["http://localhost:3000"]'
ORDERS_TRUSTED_HOSTS='["localhost","127.0.0.1"]'
ORDERS_DOCS_ENABLED=true
ORDERS_DEBUG=false
ORDERS_ALLOW_INSECURE_INTERNAL_SERVICES=true
INFRA_USER=shide
POSTGRES_PASSWORD=shide
RABBITMQ_PASSWORD=shide
