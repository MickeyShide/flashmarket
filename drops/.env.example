DROPS_ENVIRONMENT=development
DROPS_DEBUG=false
DROPS_DATABASE_URL=postgresql+asyncpg://shide:shide@shide-postgres:5432/drops
DROPS_DATABASE_API_POOL_SIZE=3
DROPS_DATABASE_API_MAX_OVERFLOW=2
DROPS_DATABASE_WORKER_POOL_SIZE=1
DROPS_DATABASE_WORKER_MAX_OVERFLOW=1
DROPS_DATABASE_POOL_TIMEOUT_SECONDS=5
DROPS_DATABASE_POOL_RECYCLE_SECONDS=1800
DROPS_API_MEMORY_LIMIT=192m
DROPS_WORKER_MEMORY_LIMIT=160m
DROPS_MAINTENANCE_MEMORY_LIMIT=128m
DROPS_RABBITMQ_URL=amqp://shide:shide@shide-rabbitmq:5672/flashmarket
CELERY_BROKER_URL=amqp://shide:shide@shide-rabbitmq:5672/flashmarket-tasks
DROPS_LOG_FILE_PATH=
DROPS_PROMETHEUS_MULTIPROC_DIR=
DROPS_DOCS_ENABLED=true
DROPS_TRUSTED_HOSTS=["localhost","127.0.0.1"]
DROPS_CORS_ORIGINS=["http://localhost:3000"]
DROPS_ALLOW_INSECURE_INTERNAL_SERVICES=true
